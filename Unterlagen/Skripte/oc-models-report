#!/usr/bin/env python3
import json
import os
import re
import shutil
import sys

HDR = re.compile(r"^([A-Za-z0-9_.-]+/.+?)\s*$")


def load_models(path):
    models = []
    current_id = None
    buf = []
    with open(path) as fh:
        for line in fh:
            m = HDR.match(line)
            if m:
                if current_id is not None:
                    _emit(models, current_id, buf)
                current_id = m.group(1)
                buf = []
            elif current_id is not None:
                buf.append(line)
    if current_id is not None:
        _emit(models, current_id, buf)
    return models


def _emit(models, current_id, buf):
    try:
        models.append((current_id, json.loads("".join(buf))))
    except json.JSONDecodeError:
        print(f"warning: skipping truncated/invalid model block '{current_id}'", file=sys.stderr)


def fmt_money(v):
    if v == int(v):
        return str(int(v))
    return ("%.3f" % v).rstrip("0").rstrip(".")


def fmt_cost(c):
    i, o = c.get("input", 0), c.get("output", 0)
    if i == 0 and o == 0:
        return "free"
    return f"{fmt_money(i)}/{fmt_money(o)}"


def fmt_ctx(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.0f}m"
    if n >= 1000:
        return f"{n / 1000:.0f}k"
    return str(n)


def fmt_model(qid, w):
    if len(qid) <= w:
        return qid
    return "…" + qid[-(w - 1):]


def flag(b):
    return "✓" if b else "–"


def modcell(inb, outb):
    return flag(inb) + flag(outb)


def matches(rec, args):
    _, data = rec
    prov = data.get("providerID", "")
    id_, name, family = data["id"], data.get("name", ""), data.get("family", "")
    hay = f"{prov} {id_} {name} {family}".lower()
    return any(a.lower() in hay for a in args)


def main(argv):
    default = os.path.join(os.path.expanduser("~"), "f")
    path = os.environ.get("OC_MODELS_REPORT", default)
    args = list(argv)
    if args and os.path.isfile(args[0]):
        path = args.pop(0)

    if not args:
        print("usage: oc-models-report <substring> [<substring> ...]  [path-to-dump]", file=sys.stderr)
        return 2

    if not os.path.isfile(path):
        print(f"dump not found: {path}", file=sys.stderr)
        print(f"create it with: opencode models --verbose > {path}", file=sys.stderr)
        return 2

    models = load_models(path)
    hits = [r for r in models if matches(r, args)]
    hits.sort(key=lambda r: r[0])

    if not hits:
        print(f"no models match: {' '.join(args)}", file=sys.stderr)
        return 1

    cost_w = 11
    ctx_w = 6
    flagcols = [("REA", 3), ("TOOL", 4), ("TMP", 3), ("ATT", 3)]
    modcols = [("TXT", 3), ("IMG", 4), ("AUD", 4), ("VID", 4), ("PDF", 4)]
    term = shutil.get_terminal_size(fallback=(100, 24)).columns
    flag_w = sum(w for _, w in flagcols) + len(flagcols) - 1
    mod_w = sum(w for _, w in modcols) + len(modcols) - 1
    overhead = 1 + cost_w + 1 + ctx_w + 1 + flag_w + 2 + mod_w
    W = max(8, term - overhead - 1)
    hdr = (
        f"{'MODEL':<{W}} {'$/MTok':<{cost_w}} {'CTX':<{ctx_w}} "
        + " ".join(f"{name:<{w}}" for name, w in flagcols)
        + "  "
        + " ".join(f"{name:<{w}}" for name, w in modcols)
    )
    print(hdr)
    print("-" * len(hdr))
    for qid, d in hits:
        caps = d.get("capabilities", {})
        inn = caps.get("input", {})
        out = caps.get("output", {})
        flagvals = [
            flag(caps.get("reasoning")),
            flag(caps.get("toolcall")),
            flag(caps.get("temperature")),
            flag(caps.get("attachment")),
        ]
        modvals = [
            modcell(inn.get("text"), out.get("text")),
            modcell(inn.get("image"), out.get("image")),
            modcell(inn.get("audio"), out.get("audio")),
            modcell(inn.get("video"), out.get("video")),
            modcell(inn.get("pdf"), out.get("pdf")),
        ]
        line = (
            f"{fmt_model(qid, W):<{W}} {fmt_cost(d.get('cost', {})):<{cost_w}} "
            f"{fmt_ctx(d.get('limit', {}).get('context', 0)):<{ctx_w}} "
            + " ".join(f"{v:<{w}}" for v, (_, w) in zip(flagvals, flagcols))
            + "  "
            + " ".join(f"{v:<{w}}" for v, (_, w) in zip(modvals, modcols))
        )
        print(line)
    print(f"\n{len(hits)} match(es) for: {' '.join(args)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
